{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimFleet",
  "mainBinaryName": "simfleet",
  "version": "5.5.0",
  "identifier": "org.n0xful.msfsaddonsbrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SimFleet",
        "width": 460,
        "height": 540,
        "minWidth": 440,
        "minHeight": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "skipTaskbar": false,
        "shadow": true,
        "theme": "Dark"
      },
      {
        "label": "osd",
        "title": "SimFleet OSD",
        "url": "index.html",
        "width": 380,
        "height": 168,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/airports.csv": "resources/airports.csv",
      "resources/SimConnect.dll": "./SimConnect.dll"
    }
  }
}
